<?xml version="1.0" encoding="UTF-8"?>
<plugin>

   <!-- JSON Content-Type -->
   <extension
         point="org.eclipse.core.runtime.contentTypes">
      <content-type
            base-type="org.eclipse.core.runtime.text"
            file-extensions="json"
            id="de.drremote.jsonplugin.contenttype.json"
            name="JSON File"
            icon="icons/json.png">
      </content-type>
   </extension>

   <!-- Editor registration -->
   <extension
         point="org.eclipse.ui.editors">
      <editor
            class="de.drremote.jsonplugin.editor.JSONEditor"
            contributorClass="org.eclipse.ui.texteditor.BasicTextEditorActionContributor"
            default="true"
            extensions="json"
            id="de.drremote.jsonplugin.editor.JSONEditor"
            name="JSON Editor"
            icon="icons/json.png">
      </editor>
   </extension>

   <!-- Preference page -->
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            id="de.drremote.jsonplugin.preferences.JSONPreferencePage"
            name="DRremote JSON Editor"
            class="de.drremote.jsonplugin.editor.preferences.JSONPreferencePage">
      </page>
   </extension>

   <!-- Command: Format JSON -->
   <extension
         point="org.eclipse.ui.commands">
      <command
            id="de.drremote.jsonplugin.commands.formatJson"
            name="Format JSON"
            categoryId="org.eclipse.ui.category.edit">
      </command>
   </extension>

   <!-- Keybinding: Ctrl+Shift+F -> Format JSON -->
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="de.drremote.jsonplugin.commands.formatJson"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="org.eclipse.ui.textEditorScope"
            sequence="M1+M2+F">
      </key>
   </extension>

</plugin>
